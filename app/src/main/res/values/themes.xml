<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Cold-start window: near-black matching the emblem so launch never
         flashes white before Compose draws its own theme. -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>